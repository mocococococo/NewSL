// このPCが起動時に読む運用設定です。実行中の変更は自動反映しません。
// // 行コメントと /* ブロックコメント */ を使えます。末尾カンマは使えません。
// 相対パスはNewSL直下を基準にします。Windowsパスは / を使うと記述が簡単です。
// パスワードはこのファイルへ書かず、env_fileまたは環境変数に設定してください。
{
  // 設定形式のバージョン。現在は1固定です。
  "schema_version": 1,
  // このPCの認証情報を読む.env。同名の環境変数がある場合は環境変数を優先します。
  "env_file": ".temp/remote_ssh/.env",

  // このPCから接続する中継SSHサーバーの設定。
  "gateway": {
    // 中継サーバーのホスト名。
    "host": "ssh.cc.uec.ac.jp",
    // 中継サーバーへログインするアカウント名。
    "username": "k2531031",
    // このPCにある中継用秘密鍵。~ はこのPCで実行するユーザーのホームです。
    "key_file": "~/.ssh/uec_rsa_key",
    // このPCにある、事前確認済みの中継サーバーのホスト鍵の登録先。
    "known_hosts": "~/.ssh/known_hosts"
  },

  // このPCでも遠隔PCと同時にチャンクを生成します。
  "local": {
    // このPCの識別名。遠隔PCと重複させず、実行途中では変更しません。
    "pc_id": "local",
    // このPCで同時に生成するプロセス数（1以上）。GPUメモリに合わせて調整します。
    "workers": 4,
    // 生成プロセス1個あたりのPyTorch CPUスレッド数（1以上）。
    "threads_per_worker": 2,
    // このPCに事前配置した入力ログのディレクトリ。遠隔側と同じ内容が必要です。
    "log_path": "LearnLog/all"
  },

  // 遠隔PCを増やす場合は、この配列へ同じ構造の設定を追加します。
  "remotes": [
    {
      // 遠隔PCの識別名。IP登録JSONのpc_idとknown_hostsの登録名を一致させます。
      "pc_id": "remote-01",
      // この遠隔PCで同時に生成するプロセス数（1以上）。
      "workers": 4,
      // 遠隔の生成プロセス1個あたりのPyTorch CPUスレッド数（1以上）。
      "threads_per_worker": 2,
      // 遠隔PCにあるNewSLリポジトリの絶対パス。
      "root": "C:/Users/itolab/DigitalCurling/NewSL",
      // 遠隔のSSH環境から使えるPython。仮想環境を使う場合はその実行ファイルを指定します。
      "python": "python",
      // 遠隔PCのSSHログインユーザー名。
      "username": "itolab",
      // このPCの.envまたは環境変数に設定するパスワードの変数名。パスワードそのものではありません。
      "password_env": "PC_PASSWORD",
      // このPCにある、事前確認済みの遠隔PCのホスト鍵の登録先。
      "known_hosts": ".temp/remote_ssh/remote_known_hosts",
      // 中継サーバー上のIP登録JSONの絶対パス。接続のたびにここからVPN IPを読みます。
      "registry_path": "/home1/y2025/k2531031/research/remote-01.json",
      // 遠隔のrootを基準とする入力ログの場所。入力ログは事前に配置してください。
      "log_path": "LearnLog/all"
    }
  ],

  // 全PC共通の状態確認・再試行条件。停止後に変更して--resumeできます。
  "control": {
    // 状態確認後の待ち時間（秒、0より大きい値）。通信時間を含む厳密な固定周期ではありません。
    "poll_seconds": 30,
    // SSH通信失敗時の追加再試行回数（0以上）。0なら再試行しません。
    "connection_retries": 12,
    // SSH通信を再試行するまでの待ち時間（秒、0より大きい値）。
    "retry_seconds": 5,
    // 起動指示後もidleのとき、同じジョブの起動を再指示するまでの猶予（秒）。
    "start_grace_seconds": 30,
    // 生成開始が状態に記録されないときの起動指示回数の上限（1以上）。
    "start_attempts": 3
  },

  // 通信のタイムアウト。すべて秒単位・0より大きい値です。
  "transport": {
    // SSH接続・認証・中継トンネル開設で使用するタイムアウト。
    "connect_timeout_seconds": 15,
    // IP登録JSONや生成データをSFTPで読み書きするときの入出力タイムアウト。
    "io_timeout_seconds": 30,
    // コマンド応答の待ち時間。事前照合やgit pullにも適用され、生成処理全体の制限時間ではありません。
    "command_timeout_seconds": 300
  },

  // 各ワーカーへ渡す生成条件。再開時は同じ設定を使います。
  "generation": {
    // shotまたはshot_origin。既存のsearch_config.pyのSEARCH_MODEと一致させます。
    "search_mode": "shot",
    // 全PCに事前配置するベースモデルの相対パス。選択した探索モードに対応するモデルが必要です。
    "base_model": "model/js20000CP-32-9-LeaRate1000-vx32-vy25-batchsize1024.bin",
    // 生成・学習を開始するend（0〜9）。end9/shot15からend0/shot0へ逆順に進みます。
    "start_end": 9,
    // 開始shot（0〜15）。15未満から始める場合は、同じendのshot+1の学習済みモデルが必要です。
    "start_shot": 15,
    // 終了end（0〜9）。終了位置も生成・学習に含めます。
    "stop_end": 0,
    // 終了shot（0〜15）。開始位置より逆順の範囲になるよう指定します。
    "stop_shot": 0,
    // 各end・shotで生成する開始チャンク番号（0以上）。
    "chunk_start": 0,
    // 終了チャンク番号（開始番号以上、終了番号も含む）。0〜7なら8チャンクです。
    "chunk_end": 7,
    // 1チャンクに割り当てる入力ログ数（1以上）。NPZ内の学習サンプル数とは別です。
    "chunk_size": 1024,
    // 1チャンクの処理ログ数の上限（1以上）。生成される学習サンプル数の指定ではありません。
    "data_size": 70000,
    // 入力ログを並べ替える乱数シード（0以上）。全PCで同じチャンク構成を作ります。
    "shuffle_seed": 12345,
    // 探索用の基準乱数シード（0以上）。チャンク番号と組み合わせて使います。
    "simulation_seed": 0,
    // 探索中の推論バッチサイズ（1以上）。大きくする場合はGPUメモリ使用量に注意します。
    "inference_batch_size": 64,
    // 1局面の探索に渡すシミュレーション回数（1以上）。増やすと通常は生成時間も増えます。
    "max_simulations": 1022,
    // trueなら他のendの入力局面も対象endとして使います。falseなら対象endのログだけを使います。
    "use_end_augmentation": true,
    // trueなら得点差を-8〜8へ展開します。falseならログに記録された得点差を使います。
    "use_score_diff_augmentation": false,

    // 以下はpolicy教師分布の設定です。win_value教師の作成にも同じ設定を使います。
    // 採用する探索候補の最低訪問回数（1以上）。
    "policy_min_visit": 3,
    // 選択された最善候補のQ値から許容する差（0以上）。大きいほど候補を広く採用します。
    "policy_delta_q": 1.0,
    // 候補の重みの訪問回数部分：訪問回数 ** alpha_visit（0以上）。
    "policy_alpha_visit": 0.2,
    // 候補の重みのQ値部分：exp(beta_q * (Q - Q_best))の係数（0以上）。
    "policy_beta_q": 0.3,
    // 最善行動のone-hot分布を混ぜる割合（0〜1）。0なら候補分布、1なら最善行動のみです。
    "policy_lambda_best": 0.5,

    // 以下はvalue教師の得点分布を作る設定です。
    // 採用する探索候補の最低訪問回数（1以上）。
    "value_min_visit": 3,
    // 最善候補のQ値から許容する差（0以上）。0ならQがQ_best以上の候補を採用します。
    "value_delta_q": 0.0,
    // 得点分布を合成する重みの訪問回数部分：訪問回数 ** alpha_visit（0以上）。
    "value_alpha_visit": 0.5,
    // 得点分布を合成する重みのQ値部分：exp(beta_q * (Q - Q_best))の係数（0以上）。
    "value_beta_q": 0.5,
    // 最善候補の得点分布を混ぜる割合（0〜1）。残りの割合は候補全体から合成した分布です。
    "value_lambda_best": 0.5
  },

  // 学習はこのPCだけで行います。学習率やオプティマイザーは既存のlearning_param.py等を使います。
  "training": {
    // 学習のミニバッチサイズ（1以上）。生成データに少なくとも1バッチ分の学習用データが必要です。
    "batch_size": 1024,
    // 各end・shotで学習するエポック数（1以上）。
    "epochs": 50
  },

  // 学習したモデルはこのPCからpushし、遠隔PCでpullします。
  "git": {
    // 全PCに設定されているGitリモート名。ブランチはパイプライン開始時のブランチを使います。
    "remote": "origin"
  }
}
